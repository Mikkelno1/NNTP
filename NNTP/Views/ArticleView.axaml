<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NNTP.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="NNTP.Views.ArticleView"
             x:DataType="vm:ArticleViewModel">
    
    
    <Grid 
        ColumnDefinitions="150,*,*"
        RowDefinitions="*,*,*"
        Margin="0,20,0,0">
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Button 
                Content="Save" 
                Margin="80,200,0,0"
                Classes="loginButton"
                Command="{Binding AddToFavoriteCommand}"
                x:Name="SaveButton"/>
            <StackPanel Orientation="Vertical">
                <Button 
                    Content="Delete group" 
                    Margin="20,275,0,0"
                    Classes="loginButton"
                    Command="{Binding RemoveFromFavoriteCommand}"
                    x:Name="DeleteButton"/>
                <Button 
                    Content="Load articles" 
                    Margin="20,10,0,0"
                    Classes="loginButton"
                    x:Name="LoadButton"/>
            </StackPanel>
            
        </StackPanel>
        
        <StackPanel Grid.Column="1" Grid.Row="0">
            <ListBox 
                Height="400" 
                Margin="0,0,0,40"
                ItemsSource="{Binding NewsGroupCollection}"
                SelectedItem="{Binding SelectedNewsGroup}"
                x:Name="NewsgroupList"
                IsVisible="True"/>
            <ListBox 
                Height="150"
                ItemsSource="{Binding FavoriteCollection}"
                SelectedItem="{Binding SelectedNewsGroup}"
                x:Name="SavedList"
                IsVisible="True"/>
            <TextBlock
                HorizontalAlignment="Center"
                Margin="0,40"
                Text="{Binding StatusCode}"
                TextWrapping="Wrap"/>
        </StackPanel>
        
        <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center">
            <TextBox
                Width="150"
                Margin="0,15,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="From"
                Text="{Binding FromArticle}"
                x:Name="FromBox"
                />
            <TextBox
                Width="150"
                Margin="0,30,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="Newsgroups"
                Text="{Binding NewsgroupsArticle}"
                x:Name="NewsgroupBox"
            />
            <TextBox
                Width="150"
                Margin="0,30,0,0"
                HorizontalAlignment="Left"
                PlaceholderText="Subject"
                Text="{Binding SubjectArticle}"
                x:Name="SubjectBox"
            />
            <TextBox
                Width="250"
                Height="200"
                Margin="0,30,0,0"
                PlaceholderText="Message"
                Text="{Binding MessageArticle}"
                x:Name="MessageBox"
            />
            <Button
                Content="Create article" 
                Margin="0,20,0,0"
                Classes="loginButton"
                Command="{Binding CreateArticleCommand}"
                x:Name="ArticleButton"/>
            
            <TextBox
                Width="150"
                Margin="40"
                PlaceholderText="Enter prompt"
                Text="{Binding NntpCommand}"
                x:Name="PromptBox">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding PromptCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <TextBlock
                Margin="0,40"
                HorizontalAlignment="Center"
                Text="{Binding StatusMessagePrompt}"
                TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
    
    
</UserControl>
