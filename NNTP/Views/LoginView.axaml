<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NNTP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NNTP.Views.LoginView"
        x:DataType="vm:LoginViewModel"
        >

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="60">
            <StackPanel HorizontalAlignment="Center">
                <TextBox
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    PlaceholderText="Username"
                    Width="150"
                    Text="{Binding User.Username}"/>
                <TextBox
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    PlaceholderText="Password"
                    Width="150"
                    Text="{Binding User.Password}"
                    PasswordChar="*"/>
                <Button
                    HorizontalAlignment="Center"
                    Margin="0,80,0,0"
                    Content="Login"
                    Command="{Binding NavigateCommand}"
                    Classes="loginButton"/>
                <StackPanel 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <Button
                        Margin="20,40"
                        Content="Save user"
                        Command="{Binding EncryptInformationCommand}"
                        Classes="loginButton"/>
                    <Button
                        Margin="20,40"
                        Content="Load user"
                        Command="{Binding DecryptInformationCommand}"
                        Classes="loginButton"/>
                </StackPanel>
                <TextBlock
                    HorizontalAlignment="Center"
                    Margin="0,80,0,0"
                    Width="350"
                    Height="100"
                    Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
            
            <StackPanel HorizontalAlignment="Center">
                <TextBox
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    PlaceholderText="Server address"
                    Width="150"
                    Text="{Binding Host.Address}"/>
                <TextBox
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0"
                    PlaceholderText="Server port"
                    Width="150"
                    Text="{Binding Host.Port}"/>
                <Button
                    HorizontalAlignment="Center"
                    Margin="0,80,0,0"
                    Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Classes="loginButton"/>
                <StackPanel 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <Button
                        Margin="20,40"
                        Content="Save server"
                        Command="{Binding SaveServerCommand}"
                        Classes="loginButton"/>
                    <Button
                        Margin="20,40"
                        Content="Load server"
                        Command="{Binding LoadServerCommand}"
                        Classes="loginButton"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>